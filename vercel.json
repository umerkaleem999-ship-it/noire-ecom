{
  "version": 2,
  "name": "noire-ecom",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/admin",   "dest": "/admin.html" },
    { "src": "/",        "dest": "/index.html" },
    { "src": "/(.*)",    "dest": "/$1" }
  ],
  "env": {
    "SUPABASE_URL":              "@supabase_url",
    "SUPABASE_ANON_KEY":         "@supabase_anon_key",
    "SUPABASE_SERVICE_ROLE_KEY": "@supabase_service_role_key",
    "ADMIN_SECRET":              "@admin_secret"
  }
}
